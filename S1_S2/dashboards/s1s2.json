      "title": "S2: Minimalna oszacowana temperatura przy gruncie (°C)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 16,
        "h": 9
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "REPLACE_WITH_CLICKHOUSE_UID"
      },
      "targets": [
        {
          "refId": "A",
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT event_hour AS time, min(min_ground_est_c) AS value FROM rbd.s2_hourly WHERE region_id = '${region_id}' GROUP BY event_hour ORDER BY event_hour"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "S2: Liczba godzin z alertami dla grup upraw",
      "type": "table",
      "gridPos": {
