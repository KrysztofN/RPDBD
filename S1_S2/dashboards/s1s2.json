        "w": 8,
        "h": 9
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "REPLACE_WITH_CLICKHOUSE_UID"
      },
      "targets": [
        {
          "refId": "A",
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT crop_group, count() AS alert_hours, min(min_ground_est_c) AS min_temp_c FROM rbd.s2_frost_alerts WHERE region_id = '${region_id}' GROUP BY crop_group ORDER BY crop_group"
