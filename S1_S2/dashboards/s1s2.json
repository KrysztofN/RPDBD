      "id": 1,
      "title": "S1: Bilans wodny 60 dni (mm)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 16,
        "h": 9
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "REPLACE_WITH_CLICKHOUSE_UID"
      },
      "targets": [
        {
          "refId": "A",
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT toDateTime(day) AS time, kbw_60d_mm AS value FROM rbd.s1_balance FINAL WHERE region_id = '${region_id}' AND days_60d=60 ORDER BY day"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:mm",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": -150
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "S1: Alerty niedoboru wody (dni)",
      "type": "stat",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 9
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "REPLACE_WITH_CLICKHOUSE_UID"
      },
      "targets": [
        {
          "refId": "A",
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT countIf(alert=1) AS alert_days FROM rbd.s1_balance FINAL WHERE region_id = '${region_id}'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
