    {
      "id": 3,
      "type": "timeseries",
      "title": "Krzywa NDVI pól: wybrany powiat, rok $year, na tle normy",
      "description": "Szare pasmo: norma (25–75% lat 2001–2017 bez lat skrajnych).  Oś X: miesiące wybranego roku.",
      "gridPos": {
        "h": 12,
        "w": 16,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-rbd"
      },
      "targets": [
        {
          "refId": "A",
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT toDateTime(makeDate(2000, toMonth(date), toDayOfMonth(date))) AS time, round(norm_p25, 3) AS norma_p25, round(norm_p75, 3) AS norma_p75, round(norm_mean, 3) AS norma, round(ndvi_smooth, 3) AS ndvi_wygladzone, round(ndvi_mean, 3) AS ndvi_pomiar FROM rbd.b1_periods WHERE region_id = ${county:singlequote} AND year = ${year:raw} ORDER BY time"
        }
      ],
