              "idField": "region_id",
              "rules": [],
              "style": {
                "color": {
                  "fixed": "#808080"
                },
                "opacity": 0.15,
                "lineWidth": 0.5
              },
              "dataStyle": {
                "color": {
                  "field": "ocena",
                  "fixed": "dark-green"
                },
                "opacity": 0.75
              }
            }
          }
        ]
      }
    },
    {
      "id": 2,
      "type": "barchart",
      "title": "Ile powiatów miało sezon IV–IX gorzej / lepiej niż zwykle (z 314)",
      "gridPos": {
        "h": 14,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
