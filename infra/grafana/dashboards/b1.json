        "query": "SELECT DISTINCT toString(year) FROM rbd.b1_season ORDER BY 1 DESC",
        "definition": "SELECT DISTINCT toString(year) FROM rbd.b1_season ORDER BY 1 DESC",
        "current": {
          "text": "2018",
          "value": "2018"
        },
        "refresh": 1
      },
      {
        "name": "county",
        "label": "Powiat",
        "type": "query",
        "datasource": {
          "type": "grafana-clickhouse-datasource",
          "uid": "clickhouse-rbd"
        },
        "query": "SELECT concat(county_name, ' – ', voiv_name, ' (', region_id, ')') FROM rbd.counties WHERE is_city = 0 ORDER BY county_name",
        "definition": "SELECT concat(county_name, ' – ', voiv_name, ' (', region_id, ')') FROM rbd.counties WHERE is_city = 0 ORDER BY county_name",
        "regex": "/^(?<text>.*) \\((?<value>\\d{4})\\)$/",
