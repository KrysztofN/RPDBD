      },
      "targets": [
        {
          "refId": "A",
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT toString(year) AS rok, countIf(status = 'gorzej niż zwykle') AS gorzej, countIf(status = 'lepiej niż zwykle') AS lepiej FROM rbd.b1_season GROUP BY year ORDER BY year"
