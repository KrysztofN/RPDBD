  "panels": [
    {
      "id": 1,
      "type": "geomap",
      "title": "Sezon IV–IX $year: stan upraw na tle typowych lat",
      "description": "Kolor = z (ile typowych odchyleń od normy). Czerwony: gorzej niż zwykle (z ≤ -1), zielony: typowo, niebieski: lepiej niż zwykle (z ≥ 1). W dymku: % typowej zieloności.",
      "gridPos": {
        "h": 14,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-rbd"
      },
      "targets": [
        {
          "refId": "A",
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT s.region_id AS region_id, c.county_name AS powiat, multiIf(s.status = 'gorzej niż zwykle', -1, s.status = 'lepiej niż zwykle', 1, 0) AS ocena, round(s.pct_of_norm, 1) AS proc_normy, round(s.z, 2) AS z, s.status AS status FROM rbd.b1_season AS s INNER JOIN rbd.counties AS c ON c.region_id = s.region_id WHERE s.year = ${year:raw}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": -0.5
              },
              {
                "color": "blue",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "view": {
          "id": "coords",
          "lat": 52.0,
          "lon": 19.3,
          "zoom": 5.6
        },
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": true,
          "showAttribution": true
        },
        "basemap": {
