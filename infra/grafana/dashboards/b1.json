    {
      "id": 4,
      "type": "table",
      "title": "Powiaty najdłużej gorzej niż zwykle w $year",
      "description": "Najdłuższa seria kolejnych terminów (16-dniowych) gorzej niż zwykle w roku i najniższe z.",
      "gridPos": {
        "h": 12,
        "w": 8,
        "x": 16,
        "y": 14
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-rbd"
      },
      "targets": [
        {
          "refId": "A",
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT county_name AS powiat, voiv_name AS wojewodztwo, max(below_streak) AS terminy_gorzej, round(min(z), 2) AS najnizsze_z FROM rbd.b1_periods WHERE year = ${year:raw} GROUP BY county_name, voiv_name HAVING terminy_gorzej > 0 ORDER BY terminy_gorzej DESC, najnizsze_z ASC LIMIT 25"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
