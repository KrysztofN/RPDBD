        {
          "refId": "A",
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT year AS rok, formatDateTime(start_date, '%d.%m') AS start, round(start_shift) AS start_dni, formatDateTime(peak_date, '%d.%m') AS szczyt, round(peak_shift) AS szczyt_dni, formatDateTime(end_date, '%d.%m') AS koniec, round(end_shift) AS koniec_dni, round(length_days) AS dlugosc_dni, round(peak_ndvi, 2) AS ndvi_szczyt FROM rbd.b2_phenology WHERE crop_class = 'arable' AND region_id = ${county:singlequote} ORDER BY year DESC"
        }
