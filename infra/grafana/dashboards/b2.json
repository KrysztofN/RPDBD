        {
          "refId": "A",
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT region_id, county_name AS powiat, multiIf(${metric:raw}_status = 'wcześniej niż zwykle', -1, ${metric:raw}_status = 'później niż zwykle', 1, 0) AS ocena, round(${metric:raw}_shift) AS przesuniecie_dni, formatDateTime(${metric:raw}_date, '%d.%m') AS data, ${metric:raw}_status AS status FROM rbd.b2_phenology WHERE crop_class = 'arable' AND year = ${year:raw}"
