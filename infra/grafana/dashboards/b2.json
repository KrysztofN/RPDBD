        "h": 13,
        "w": 10,
        "x": 14,
        "y": 26
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-rbd"
      },
      "targets": [
        {
          "refId": "A",
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT multiIf(crop_class = 'winter_cereals_rapeseed', 'zboża ozime i rzepak', crop_class = 'spring_cereals', 'zboża jare', crop_class = 'maize', 'kukurydza', crop_class = 'root_crops', 'okopowe', crop_class = 'grassland', 'łąki i pastwiska', crop_class = 'other_crops', 'inne uprawy', 'pola orne (wszystkie)') AS grupa, year AS rok, formatDateTime(start_date, '%d.%m') AS start, formatDateTime(peak_date, '%d.%m') AS szczyt, formatDateTime(end_date, '%d.%m') AS koniec, round(peak_ndvi, 2) AS ndvi_szczyt FROM rbd.b2_phenology WHERE region_id = ${county:singlequote} AND year IN (2018, 2022) ORDER BY grupa, rok"
        }
      ],
      "options": {
